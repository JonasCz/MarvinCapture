# --- Vendor binaries -------------------------------------------------------
# The vendor driver and its installer are Pinnacle's and are NOT redistributed.
# (The FPGA bitstreams in firmware/ are a deliberate exception -- see
# firmware/README.md.)
*.msi
*.sys
marvin/
pinnaclembusb/

# --- Recordings ------------------------------------------------------------
# Captured video and USB traces are never committed. tests/data/ holds small
# local fixtures for the replay tests; see tests/data/README.md.
*.pcap
*.pcapng
*.avi
*.dv
*.ts
tests/data/*
!tests/data/README.md

# --- Build output ----------------------------------------------------------
build/
build-*/
*.o
*.a
*.exe

# --- Vendored FFmpeg (fetched/built by scripts/build-ffmpeg.sh) ------------
# Source tarball + extracted tree, and the per-OS/arch build and install
# directories. None of this is committed; the script re-fetches and
# re-verifies (sha256) on demand. See third_party/README.md.
third_party/ffmpeg-src/
third_party/ffmpeg-*/

# --- Local / editor --------------------------------------------------------
.claude/*
!.claude/skills/
__pycache__/
*.pyc
.DS_Store
