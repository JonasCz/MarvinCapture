<UserControl
    x:Class="PinnacleCapture.Views.KindSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PinnacleCapture.ViewModels">

    <!-- One "Settings for: DV | HDV" page: format, title, scene split, idle stop, passes. -->
    <StackPanel Spacing="10">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <ComboBox
            Header="Format"
            HorizontalAlignment="Stretch"
            ItemsSource="{x:Bind ViewModel.Formats}"
            SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
            IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
            AutomationProperties.Name="{x:Bind FormatAutomationName}">
            <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:FormatItem">
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Extension}"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>
                </DataTemplate>
            </ComboBox.ItemTemplate>
        </ComboBox>
            <ComboBox Grid.Column="1" Header="Aspect" HorizontalAlignment="Stretch"
                      SelectedIndex="{x:Bind ViewModel.AspectIndex, Mode=TwoWay}"
                      IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                      AutomationProperties.Name="{x:Bind AspectAutomationName}"
                      AutomationProperties.HelpText="Overrides the aspect ratio for the preview and the file. Auto uses what the tape reports.">
                <ComboBoxItem Content="Auto" />
                <ComboBoxItem Content="4:3" />
                <ComboBoxItem Content="16:9" />
            </ComboBox>
        </Grid>

        <CheckBox
            Content="Split into scenes"
            IsChecked="{x:Bind ViewModel.SplitIntoScenes, Mode=TwoWay}"
            IsEnabled="{x:Bind Both(ViewModel.SplitEnabled, IsEditable), Mode=OneWay}"
            AutomationProperties.HelpText="Starts a new numbered file at every recording start, timecode jump or date change on the tape." />

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                Header="Stop no signal (min)"
                Minimum="0" Maximum="600" SmallChange="1" LargeChange="5"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.IdleStopMinutes, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                AutomationProperties.Name="Stop when no signal for this many minutes"
                AutomationProperties.HelpText="Ends the pass after this many minutes without signal or data. With passes left, rewinds and starts the next one. 0 disables it (never stops automatically)."
                ToolTipService.ToolTip="Ends the pass after this many minutes without signal or data. With passes left, rewinds and starts the next one. 0 disables it (never stops automatically)." />
            <NumberBox
                Grid.Column="1"
                Header="Stop after (min)"
                Minimum="0" Maximum="600" SmallChange="1" LargeChange="5"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.MaxDurationMinutes, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                AutomationProperties.Name="Stop this many minutes into the pass, regardless of signal"
                AutomationProperties.HelpText="Ends the pass after this many minutes of capture, per pass, excluding rewind time (the count restarts with each pass), whether or not signal is present. With passes left, rewinds and starts the next one; in the last pass it ends the capture and stops the tape. 0 disables it."
                ToolTipService.ToolTip="Ends the pass after this many minutes of capture, per pass, excluding rewind time (the count restarts with each pass), whether or not signal is present. With passes left, rewinds and starts the next one; in the last pass it ends the capture and stops the tape. 0 disables it." />
        </Grid>

        <NumberBox
            Header="Capture passes"
            HorizontalAlignment="Left" Width="140"
            Minimum="1" Maximum="20" SmallChange="1"
            SpinButtonPlacementMode="Compact"
            Value="{x:Bind ViewModel.DisplayPasses, Mode=TwoWay}"
            IsEnabled="{x:Bind Both(ViewModel.PassesUsable, IsEditable), Mode=OneWay}"
            AutomationProperties.Name="Capture passes"
            AutomationProperties.HelpText="{x:Bind ViewModel.PassesToolTip, Mode=OneWay}"
            ToolTipService.ToolTip="{x:Bind ViewModel.PassesToolTip, Mode=OneWay}" />
    </StackPanel>
</UserControl>
