<Window
    x:Class="PinnacleCapture.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:PinnacleCapture"
    xmlns:vm="using:PinnacleCapture.ViewModels"
    xmlns:controls="using:PinnacleCapture.Controls">

    <Grid x:Name="RootGrid" Loaded="RootGrid_Loaded" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">
        <Grid.Resources>
            <controls:DbThumbConverter x:Key="DbConverter" />

            <!-- A "card": grouped controls on the window surface. -->
            <Style x:Key="CardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16,12,16,14" />
            </Style>
            <Style x:Key="CardHeaderStyle" TargetType="TextBlock" BasedOn="{StaticResource BodyStrongTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusItemStyle" TargetType="StackPanel">
                <Setter Property="Orientation" Value="Horizontal" />
                <Setter Property="Spacing" Value="6" />
                <Setter Property="VerticalAlignment" Value="Center" />
            </Style>
            <Style x:Key="StatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="StatusIconStyle" TargetType="FontIcon">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="DeckButtonStyle" TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
                <Setter Property="HorizontalAlignment" Value="Stretch" />
                <Setter Property="Height" Value="36" />
                <Setter Property="Padding" Value="0" />
            </Style>
        </Grid.Resources>

        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ============================================================ title bar -->
        <Grid x:Name="AppTitleBar" Padding="16,0,0,0" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <FontIcon Glyph="&#xE7F4;" FontSize="16" Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                      VerticalAlignment="Center" AutomationProperties.AccessibilityView="Raw" />
            <TextBlock Grid.Column="1" Text="{x:Bind VM.WindowTitle, Mode=OneWay}"
                       Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis" />
        </Grid>

        <!-- ============================================================ content -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="384" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- ============================== left pane -->
            <ScrollViewer x:Name="LeftScroller" VerticalScrollBarVisibility="Auto" HorizontalScrollMode="Disabled"
                          AutomationProperties.Name="Capture settings">
                <StackPanel Spacing="10" Padding="16,4,12,12">

                    <InfoBar IsOpen="{x:Bind VM.InfoOpen, Mode=TwoWay}"
                             Title="{x:Bind VM.InfoTitle, Mode=OneWay}"
                             Message="{x:Bind VM.InfoMessage, Mode=OneWay}"
                             Severity="{x:Bind local:MainWindow.Severity(VM.InfoSeverity), Mode=OneWay}"
                             AutomationProperties.LiveSetting="Assertive" />

                    <!-- ============ source: device + input -->
                    <Border Style="{StaticResource CardStyle}">
                        <StackPanel Spacing="10">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- Fixed height: the two-line selection box must not shrink while the
                                     dropdown is open (the selected item moves into the popup then). -->
                                <controls:DeviceComboBox x:Name="DeviceCombo"
                                          HorizontalAlignment="Stretch" Height="56"
                                          VerticalContentAlignment="Center"
                                          ItemsSource="{x:Bind VM.Devices}"
                                          SelectedItem="{x:Bind VM.SelectedDevice, Mode=TwoWay}"
                                          IsEnabled="{x:Bind VM.DeviceSelectEnabled, Mode=OneWay}"
                                          PlaceholderText="{x:Bind local:MainWindow.DevicePlaceholder(VM.NoDevices), Mode=OneWay}"
                                          DropDownOpened="DeviceCombo_DropDownOpened"
                                          AutomationProperties.Name="Capture device"
                                          AutomationProperties.HelpText="Disabled while capturing. Devices used by another window can't be picked.">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="vm:DeviceItemViewModel">
                                            <Grid ColumnSpacing="8" MinHeight="40" AutomationProperties.Name="{x:Bind AutomationName}">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock Text="{x:Bind Name}" TextTrimming="CharacterEllipsis" />
                                                    <TextBlock Text="{x:Bind ShortId}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                               TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                                <Border Grid.Column="1" VerticalAlignment="Center" CornerRadius="10" Padding="8,2"
                                                        Background="{x:Bind StatusBrush}">
                                                    <TextBlock Text="{x:Bind StatusText}" Style="{StaticResource CaptionTextBlockStyle}"
                                                               Foreground="{x:Bind StatusForeground}" />
                                                </Border>
                                            </Grid>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </controls:DeviceComboBox>
                                <Button Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                        Width="28" VerticalAlignment="Stretch" Padding="0" Margin="-4,0,-8,0"
                                        AutomationProperties.Name="More options"
                                        ToolTipService.ToolTip="More options">
                                    <FontIcon Glyph="&#xE712;" FontSize="14" />
                                    <Button.Flyout>
                                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                                            <MenuFlyoutItem Text="New window" Click="NewWindow_Click"
                                                            AutomationProperties.HelpText="Opens another capture window, for example for a second device">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE8A7;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutItem Text="Command-line help" Click="Help_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE756;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                            <MenuFlyoutSeparator />
                                            <MenuFlyoutItem Text="About" Click="About_Click">
                                                <MenuFlyoutItem.Icon>
                                                    <FontIcon Glyph="&#xE946;" />
                                                </MenuFlyoutItem.Icon>
                                            </MenuFlyoutItem>
                                        </MenuFlyout>
                                    </Button.Flyout>
                                </Button>
                            </Grid>
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       Text="No devices found. Connect the Studio 500-USB and make sure it uses the WinUSB driver."
                                       TextWrapping="Wrap"
                                       Visibility="{x:Bind VM.NoDevices, Mode=OneWay}" />
                            <RadioButtons MaxColumns="3" Margin="0,2,0,0"
                                          SelectedIndex="{x:Bind VM.InputIndex, Mode=TwoWay}"
                                          IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                          AutomationProperties.Name="Input">
                                <RadioButtons.Resources>
                                    <!-- Default RadioButton MinWidth (120) forces a wrap in a 330px card. -->
                                    <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
                                        <Setter Property="MinWidth" Value="0" />
                                        <Setter Property="Padding" Value="8,6,0,0" />
                                    </Style>
                                </RadioButtons.Resources>
                                <RadioButton Content="DV / HDV" AutomationProperties.HelpText="FireWire camera or deck; DV and HDV are detected automatically" />
                                <RadioButton Content="S-Video" />
                                <RadioButton Content="Composite" />
                            </RadioButtons>
                        </StackPanel>
                    </Border>

                    <!-- ============ analog + DV panels share one cell; the inactive one is Collapsed.
                         Both: Output card first, then the source card whose last element is the
                         primary action. Nothing follows this panel, so it doesn't reserve the taller
                         child's height (that only added blank space and a scrollbar). -->
                    <controls:SameHeightSwitchPanel x:Name="PanelSwitch" ReserveMaxHeight="False"
                                                    ActiveIndex="{x:Bind VM.ActivePanelIndex, Mode=OneWay}">

                        <!-- ===== [0] analog -->
                        <StackPanel Spacing="12" AutomationProperties.Name="Analog capture options">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <TextBlock Text="Output" Style="{StaticResource CardHeaderStyle}" />
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind VM.AnalogName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Name and title"
                                                 IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                                 AutomationProperties.Name="Analog name and title"
                                                 AutomationProperties.HelpText="File name (the extension follows the format), also stored as the title metadata of the file" />
                                        <Button Grid.Column="1" VerticalAlignment="Stretch" Width="40" Padding="0" Tag="analog" Click="Browse_Click"
                                                IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                                AutomationProperties.Name="Choose analog output folder" ToolTipService.ToolTip="{x:Bind VM.AnalogOutputDir, Mode=OneWay}">
                                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="104" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox Header="Format" HorizontalAlignment="Stretch"
                                                  ItemsSource="{x:Bind VM.AnalogFormats}"
                                                  SelectedItem="{x:Bind VM.AnalogFormat, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                                  AutomationProperties.Name="Analog format">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:FormatItem">
                                                    <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <ComboBox Grid.Column="1" Header="Aspect" HorizontalAlignment="Stretch"
                                                  SelectedIndex="{x:Bind VM.AnalogAspectIndex, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                                  AutomationProperties.Name="Analog aspect ratio"
                                                  AutomationProperties.HelpText="4:3, or 16:9 for anamorphic widescreen tapes. Affects the preview and the file.">
                                            <ComboBoxItem Content="Auto" />
                                            <ComboBoxItem Content="4:3" />
                                            <ComboBoxItem Content="16:9" />
                                        </ComboBox>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <NumberBox
                                            Header="Stop no signal (min)"
                                            Minimum="0" Maximum="600" SmallChange="1" LargeChange="5"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind VM.AnalogIdleStopMinutes, Mode=TwoWay}"
                                            IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                            AutomationProperties.Name="Stop analog capture after this many minutes without signal"
                                            AutomationProperties.HelpText="Stops the capture after this many minutes without signal. 0 disables it (never stops automatically)."
                                            ToolTipService.ToolTip="Stops the capture after this many minutes without signal. 0 disables it (never stops automatically)." />
                                        <NumberBox
                                            Grid.Column="1"
                                            Header="Stop after (min)"
                                            Minimum="0" Maximum="600" SmallChange="1" LargeChange="5"
                                            SpinButtonPlacementMode="Compact"
                                            Value="{x:Bind VM.AnalogMaxDurationMinutes, Mode=TwoWay}"
                                            IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                            AutomationProperties.Name="Stop analog capture after this many minutes, regardless of signal"
                                            AutomationProperties.HelpText="Stops the capture after this many minutes, whether or not signal is present. 0 disables it (never stops automatically)."
                                            ToolTipService.ToolTip="Stops the capture after this many minutes, whether or not signal is present. 0 disables it (never stops automatically)." />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Signal" Style="{StaticResource CardHeaderStyle}" />
                                        <ComboBox Grid.Column="1" HorizontalAlignment="Right" MinWidth="150"
                                                  ItemsSource="{x:Bind VM.Standards}"
                                                  SelectedItem="{x:Bind VM.SelectedStandard, Mode=TwoWay}"
                                                  IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                                  AutomationProperties.Name="Video standard"
                                                  AutomationProperties.HelpText="Auto picks PAL or NTSC from the 50 or 60 Hz signal"
                                                  ToolTipService.ToolTip="Video standard">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate x:DataType="vm:StdItem">
                                                    <TextBlock Text="{x:Bind Name}" />
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Grid>

                                    <!-- Proc-amp sliders: live even during capture. -->
                                    <TextBlock Text="Picture adjustments" Margin="0,4,0,-4" Style="{StaticResource CardHeaderStyle}" />
                                        <ItemsControl ItemsSource="{x:Bind VM.PictureSliders}" IsTabStop="False"
                                                      AutomationProperties.Name="Picture adjustments">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <StackPanel Spacing="4" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:ControlSliderViewModel">
                                                    <Grid ColumnSpacing="4">
                                                        <Grid.RowDefinitions>
                                                            <RowDefinition Height="Auto" />
                                                            <RowDefinition Height="Auto" />
                                                        </Grid.RowDefinitions>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>
                                                        <TextBlock Text="{x:Bind Label, Mode=OneWay}" />
                                                        <TextBlock Text="{x:Bind ValueText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                        <Slider Grid.Row="1"
                                                                Minimum="{x:Bind Min, Mode=OneWay}" Maximum="{x:Bind Max, Mode=OneWay}"
                                                                StepFrequency="{x:Bind Step, Mode=OneWay}" SmallChange="{x:Bind Step, Mode=OneWay}"
                                                                Value="{x:Bind SliderValue, Mode=TwoWay}"
                                                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind Label, Mode=OneWay}" />
                                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                                                Width="32" Height="32" Padding="0"
                                                                Command="{x:Bind ResetToDefaultCommand}"
                                                                IsEnabled="{x:Bind IsEnabled, Mode=OneWay}"
                                                                AutomationProperties.Name="{x:Bind ResetName, Mode=OneWay}"
                                                                ToolTipService.ToolTip="Reset to default">
                                                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                                        </Button>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    <Grid ColumnSpacing="4">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="Audio gain" />
                                        <TextBlock Text="{x:Bind VM.AudioGain.ValueText, Mode=OneWay}" Style="{StaticResource CaptionTextBlockStyle}"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                                   HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        <Slider Grid.Row="1"
                                                Minimum="{x:Bind VM.AudioGain.Min, Mode=OneWay}" Maximum="{x:Bind VM.AudioGain.Max, Mode=OneWay}"
                                                StepFrequency="{x:Bind VM.AudioGain.Step, Mode=OneWay}" SmallChange="{x:Bind VM.AudioGain.Step, Mode=OneWay}"
                                                Value="{x:Bind VM.AudioGain.SliderValue, Mode=TwoWay}"
                                                IsEnabled="{x:Bind VM.AudioGain.IsEnabled, Mode=OneWay}"
                                                ThumbToolTipValueConverter="{StaticResource DbConverter}"
                                                AutomationProperties.Name="Audio gain in decibels" />
                                        <Button Grid.Row="1" Grid.Column="1" Style="{StaticResource SubtleButtonStyle}"
                                                Width="32" Height="32" Padding="0"
                                                Command="{x:Bind VM.AudioGain.ResetToDefaultCommand}"
                                                AutomationProperties.Name="Reset audio gain to default"
                                                ToolTipService.ToolTip="Reset to default">
                                            <FontIcon Glyph="&#xE7A7;" FontSize="14" />
                                        </Button>
                                    </Grid>

                                    <!-- primary action (last): Capture, which becomes Stop capture in place -->
                                    <Button Style="{StaticResource AccentButtonStyle}" HorizontalAlignment="Stretch"
                                            HorizontalContentAlignment="Left" Padding="16,10"
                                            Click="Capture_Click"
                                            IsEnabled="{x:Bind VM.CaptureEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind local:MainWindow.StartStopName(VM.IsCapturing), Mode=OneWay}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid Width="44" Height="40" AutomationProperties.AccessibilityView="Raw"
                                                  Opacity="{x:Bind local:MainWindow.EnabledOpacity(VM.CaptureEnabled), Mode=OneWay}">
                                                <Ellipse Width="36" Height="36" Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" Opacity="0.16" />
                                                <FontIcon Glyph="{x:Bind VM.CaptureButtonGlyph, Mode=OneWay}" FontSize="18"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Grid>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock Text="{x:Bind VM.CaptureButtonText, Mode=OneWay}" Style="{StaticResource BodyStrongTextBlockStyle}" />
                                                <TextBlock Text="{x:Bind local:MainWindow.AnalogCaptureHint(VM.IsCapturing), Mode=OneWay}"
                                                           Style="{StaticResource CaptionTextBlockStyle}" Opacity="0.8" />
                                            </StackPanel>
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===== [1] DV / HDV -->
                        <StackPanel Spacing="12" AutomationProperties.Name="DV and HDV capture options">
                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <Grid Margin="0,-6,0,-8">
                                        <TextBlock Text="Output" Style="{StaticResource CardHeaderStyle}" />
                                        <!-- which kind's file options are shown below (the path is shared) -->
                                        <SelectorBar x:Name="KindSelector" HorizontalAlignment="Right" Margin="0,0,-8,0"
                                                     SelectionChanged="KindSelector_SelectionChanged"
                                                     AutomationProperties.Name="File options for">
                                            <SelectorBarItem Text="DV" IsSelected="True" AutomationProperties.Name="DV file options" />
                                            <SelectorBarItem Text="HDV" AutomationProperties.Name="HDV file options" />
                                        </SelectorBar>
                                    </Grid>
                                    <Grid ColumnSpacing="8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{x:Bind VM.DvName, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 PlaceholderText="Name and title"
                                                 IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                                 AutomationProperties.Name="DV name and title"
                                                 AutomationProperties.HelpText="File name for DV and HDV (scenes and passes get numbered suffixes), also stored as the title metadata of the file" />
                                        <Button Grid.Column="1" VerticalAlignment="Stretch" Width="40" Padding="0" Tag="dv" Click="Browse_Click"
                                                IsEnabled="{x:Bind VM.IsIdle, Mode=OneWay}"
                                                AutomationProperties.Name="Choose DV output folder" ToolTipService.ToolTip="{x:Bind VM.DvOutputDir, Mode=OneWay}">
                                            <FontIcon Glyph="&#xED25;" FontSize="14" />
                                        </Button>
                                    </Grid>
                                    <controls:SameHeightSwitchPanel x:Name="KindSwitch" ActiveIndex="{x:Bind VM.SelectedKindTabIndex, Mode=OneWay}" />
                                </StackPanel>
                            </Border>

                            <Border Style="{StaticResource CardStyle}">
                                <StackPanel Spacing="12">
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <TextBlock Text="Tape" Style="{StaticResource CardHeaderStyle}" VerticalAlignment="Center" />
                                        <TextBlock Text="{x:Bind VM.DeckStateText, Mode=OneWay}"
                                                   TextTrimming="CharacterEllipsis"
                                                   Style="{StaticResource CaptionTextBlockStyle}" VerticalAlignment="Center"
                                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                    </StackPanel>
                                    <Grid ColumnSpacing="8" x:Name="DeckRow">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ToggleButton Style="{StaticResource DeckButtonStyle}" Tag="Rew" Click="Deck_Click"
                                                      IsChecked="{x:Bind VM.IsRewChecked, Mode=OneWay}"
                                                      IsEnabled="{x:Bind VM.DeckRewEnabled, Mode=OneWay}"
                                                      AutomationProperties.Name="Rewind" ToolTipService.ToolTip="Rewind">
                                            <FontIcon Glyph="&#xEB9E;" FontSize="16" />
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="1" Style="{StaticResource DeckButtonStyle}" Tag="Play" Click="Deck_Click"
                                                      IsChecked="{x:Bind VM.IsPlayChecked, Mode=OneWay}"
                                                      IsEnabled="{x:Bind VM.DeckPlayEnabled, Mode=OneWay}"
                                                      AutomationProperties.Name="Play" ToolTipService.ToolTip="Play">
                                            <FontIcon Glyph="&#xE768;" FontSize="16" />
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="2" Style="{StaticResource DeckButtonStyle}" Tag="Stop" Click="Deck_Click"
                                                      IsChecked="{x:Bind VM.IsStopChecked, Mode=OneWay}"
                                                      IsEnabled="{x:Bind VM.DeckStopEnabled, Mode=OneWay}"
                                                      AutomationProperties.Name="Stop"
                                                      ToolTipService.ToolTip="Stop">
                                            <FontIcon Glyph="&#xE71A;" FontSize="16" />
                                        </ToggleButton>
                                        <ToggleButton Grid.Column="3" Style="{StaticResource DeckButtonStyle}" Tag="Ff" Click="Deck_Click"
                                                      IsChecked="{x:Bind VM.IsFfChecked, Mode=OneWay}"
                                                      IsEnabled="{x:Bind VM.DeckFfEnabled, Mode=OneWay}"
                                                      AutomationProperties.Name="Fast forward" ToolTipService.ToolTip="Fast forward">
                                            <FontIcon Glyph="&#xEB9D;" FontSize="16" />
                                        </ToggleButton>
                                    </Grid>

                                    <!-- secondary: record whatever arrives, without deck control -->
                                    <Button HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Padding="16,8"
                                            Click="Capture_Click"
                                            IsEnabled="{x:Bind VM.PlayAndCaptureEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind VM.ManualCaptureTitle, Mode=OneWay}"
                                            AutomationProperties.HelpText="{x:Bind VM.ManualCaptureHelp, Mode=OneWay}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind VM.ManualCaptureGlyph, Mode=OneWay}" FontSize="16" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind VM.ManualCaptureTitle, Mode=OneWay}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>

                                    <!-- primary action (last): rewind, play, record. Same size as Manual capture,
                                         accent coloured. Turns into "Stop capture & stop tape" in place. -->
                                    <Button x:Name="PlayAndCaptureButton" Style="{StaticResource AccentButtonStyle}"
                                            HorizontalAlignment="Stretch" HorizontalContentAlignment="Left"
                                            Padding="16,8" Click="PlayAndCapture_Click"
                                            IsEnabled="{x:Bind VM.DvAutoCaptureEnabled, Mode=OneWay}"
                                            AutomationProperties.Name="{x:Bind VM.PrimaryDvTitle, Mode=OneWay}"
                                            AutomationProperties.HelpText="{x:Bind VM.PrimaryDvHelp, Mode=OneWay}">
                                        <Grid ColumnSpacing="14">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="44" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <FontIcon Glyph="{x:Bind VM.PrimaryDvGlyph, Mode=OneWay}" FontSize="16" HorizontalAlignment="Center" />
                                            <TextBlock Grid.Column="1" Text="{x:Bind VM.PrimaryDvTitle, Mode=OneWay}" VerticalAlignment="Center" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </controls:SameHeightSwitchPanel>
                </StackPanel>
            </ScrollViewer>

            <!-- ============================== right pane: preview.
                 PreviewFrame is sized in code to pin_fit_rect(dar, host) and centred, so the video
                 fills its swap chain exactly and the window background is the "letterbox". -->
            <Grid x:Name="PreviewHost" Grid.Column="1" Margin="4,4,16,16" SizeChanged="PreviewHost_SizeChanged">
                <Grid x:Name="PreviewFrame" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <SwapChainPanel x:Name="PreviewPanel" AutomationProperties.Name="Video preview" />
                    <Border CornerRadius="0" BorderThickness="1"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                            Visibility="{x:Bind local:MainWindow.Collapsed(VM.PreviewHasVideo), Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="12">
                            <FontIcon Glyph="&#xE714;" FontSize="48" Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                      AutomationProperties.AccessibilityView="Raw" />
                            <TextBlock Text="{x:Bind VM.NoVideoText, Mode=OneWay}" HorizontalAlignment="Center"
                                       TextAlignment="Center" TextWrapping="Wrap" MaxWidth="420"
                                       Style="{StaticResource BodyTextBlockStyle}"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            <ProgressBar Width="240" HorizontalAlignment="Center"
                                         Visibility="{x:Bind VM.ProgressVisible, Mode=OneWay}"
                                         IsIndeterminate="{x:Bind VM.ProgressIndeterminate, Mode=OneWay}"
                                         Minimum="0" Maximum="100" Value="{x:Bind VM.ProgressValue, Mode=OneWay}"
                                         AutomationProperties.Name="Preparing the device" />
                            <!-- no-signal timeout while capturing: the bar shrinks toward 0 -->
                            <StackPanel Spacing="6" HorizontalAlignment="Center"
                                        Visibility="{x:Bind VM.NoSignalCountdownVisible, Mode=OneWay}">
                                <TextBlock Text="{x:Bind VM.NoSignalCountdownText, Mode=OneWay}" HorizontalAlignment="Center"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <ProgressBar Width="240" HorizontalAlignment="Center"
                                             Minimum="0" Maximum="1" Value="{x:Bind VM.NoSignalCountdownFraction, Mode=OneWay}"
                                             AutomationProperties.Name="{x:Bind VM.NoSignalCountdownText, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- ============================================================ status bar -->
        <!-- Two rows, one font (StatusTextStyle: Caption, secondary colour, regular weight) for every
             text. Left to right: deck | file | time | signal | frames | storage | meters. Single-line
             items span both rows; paired ones (total/clip, size/free) stack. Counters are the core's
             (pin_status_snapshot_t): since capture start (since app start while idle) and per clip. -->
        <Border Grid.Row="2" BorderThickness="0,1,0,0" BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                Background="{ThemeResource LayerFillColorDefaultBrush}" Padding="16,4,8,4">
            <Grid ColumnSpacing="18" RowSpacing="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" MinWidth="96" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- deck status (DV / HDV input only) -->
                <StackPanel Grid.RowSpan="2" Style="{StaticResource StatusItemStyle}" ToolTipService.ToolTip="Deck status"
                            Visibility="{x:Bind VM.IsDvInput, Mode=OneWay}">
                    <FontIcon Glyph="&#xEC58;" Style="{StaticResource StatusIconStyle}" />
                    <TextBlock Text="{x:Bind VM.DeckStateText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                               TextTrimming="CharacterEllipsis"
                               AutomationProperties.Name="{x:Bind local:MainWindow.Label('Deck', VM.DeckStateText), Mode=OneWay}" />
                </StackPanel>

                <!-- the file being written, or "Ready" / the preparing step / the error; second row: the
                     capture state. pin_format_status_line is this live region's automation name. -->
                <StackPanel Grid.Column="1" Grid.RowSpan="2" VerticalAlignment="Center" Spacing="1"
                            ToolTipService.ToolTip="{x:Bind VM.StatusShortText, Mode=OneWay}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Ellipse Width="8" Height="8" VerticalAlignment="Center"
                                 Fill="{ThemeResource SystemFillColorCriticalBrush}"
                                 Visibility="{x:Bind VM.IsCapturing, Mode=OneWay}" />
                        <TextBlock x:Name="StatusBarText" Text="{x:Bind VM.StatusShortText, Mode=OneWay}"
                                   Style="{StaticResource StatusTextStyle}" TextTrimming="CharacterEllipsis"
                                   AutomationProperties.LiveSetting="Polite"
                                   AutomationProperties.Name="{x:Bind VM.StatusLine, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind VM.StatusSubText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                               TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- tape timecode (DV/HDV) or time since capture start (analog); same font as the rest -->
                <StackPanel Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource StatusItemStyle}"
                            ToolTipService.ToolTip="{x:Bind VM.StatusTimeTip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE916;" Style="{StaticResource StatusIconStyle}" />
                    <TextBlock Text="{x:Bind VM.StatusTimeText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}"
                               AutomationProperties.Name="{x:Bind local:MainWindow.Label(VM.StatusTimeTip, VM.StatusTimeText), Mode=OneWay}" />
                </StackPanel>

                <!-- signal: lock state, and what is arriving (HDV / DV / S-Video / Composite, PAL / NTSC) -->
                <StackPanel Grid.Column="3" Grid.RowSpan="2" Style="{StaticResource StatusItemStyle}"
                            ToolTipService.ToolTip="Signal: lock state, source type and video standard"
                            AutomationProperties.Name="{x:Bind local:MainWindow.SignalName(VM.SignalLockText, VM.SignalTypeText), Mode=OneWay}">
                    <FontIcon Glyph="&#xE73E;" FontSize="12" Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                              Visibility="{x:Bind VM.SignalLocked, Mode=OneWay}" />
                    <FontIcon Glyph="&#xE7BA;" FontSize="12" Foreground="{ThemeResource SystemFillColorCautionBrush}"
                              Visibility="{x:Bind local:MainWindow.Collapsed(VM.SignalLocked), Mode=OneWay}" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind VM.SignalLockText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{x:Bind VM.SignalTypeText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- frames: total on row 1, current clip on row 2 (frames / with error / dropped) -->
                <StackPanel Grid.Column="4" Grid.RowSpan="2" Style="{StaticResource StatusItemStyle}"
                            ToolTipService.ToolTip="{x:Bind VM.FramesTip, Mode=OneWay}"
                            AutomationProperties.Name="{x:Bind VM.FramesTip, Mode=OneWay}">
                    <FontIcon Glyph="&#xE8B2;" Style="{StaticResource StatusIconStyle}" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind VM.FramesTotalText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Text="{x:Bind VM.FramesClipText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" />
                    </StackPanel>
                </StackPanel>

                <!-- storage, one icon: size total / clip over free space and time left. The second copy
                     (critical colour) replaces the first when the core says disk_low. -->
                <StackPanel Grid.Column="5" Grid.RowSpan="2" Style="{StaticResource StatusItemStyle}"
                            ToolTipService.ToolTip="Storage: bytes written in this capture / in the current file, free space on the output volume and capture time left"
                            AutomationProperties.Name="{x:Bind local:MainWindow.StorageName(VM.SizeText, VM.DiskFreeText, VM.TimeLeftText, VM.DiskLow), Mode=OneWay}"
                            Visibility="{x:Bind local:MainWindow.DiskVisible(VM.HasDiskInfo, VM.DiskLow, x:False), Mode=OneWay}">
                    <FontIcon Glyph="&#xEDA2;" Style="{StaticResource StatusIconStyle}" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind VM.SizeText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Style="{StaticResource StatusTextStyle}">
                            <Run Text="{x:Bind VM.DiskFreeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind VM.TimeLeftText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="5" Grid.RowSpan="2" Style="{StaticResource StatusItemStyle}"
                            ToolTipService.ToolTip="Low disk space: less than 1 hour or 50 GB left"
                            AutomationProperties.Name="{x:Bind local:MainWindow.StorageName(VM.SizeText, VM.DiskFreeText, VM.TimeLeftText, VM.DiskLow), Mode=OneWay}"
                            Visibility="{x:Bind local:MainWindow.DiskVisible(VM.HasDiskInfo, VM.DiskLow, x:True), Mode=OneWay}">
                    <FontIcon Glyph="&#xEDA2;" FontSize="12" Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind VM.SizeText, Mode=OneWay}" Style="{StaticResource StatusTextStyle}" />
                        <TextBlock Style="{StaticResource StatusTextStyle}" Foreground="{ThemeResource SystemFillColorCriticalBrush}">
                            <Run Text="{x:Bind VM.DiskFreeText, Mode=OneWay}" /><Run Text=" · " /><Run Text="{x:Bind VM.TimeLeftText, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>
                    <!-- level meters: bar = current peak, tick = highest peak of the last 10 s -->
                    <Grid Grid.Column="6" Grid.RowSpan="2" ColumnSpacing="6" RowSpacing="1" VerticalAlignment="Center"
                          AutomationProperties.Name="{x:Bind VM.AudioPeakText, Mode=OneWay}"
                          ToolTipService.ToolTip="{x:Bind VM.AudioPeakText, Mode=OneWay}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="160" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="L" Style="{StaticResource StatusTextStyle}" />
                        <controls:LevelMeter Grid.Column="1" Level="{x:Bind VM.AudioPeakLeft, Mode=OneWay}"
                                             Hold="{x:Bind VM.AudioHoldLeft, Mode=OneWay}"
                                             AutomationProperties.Name="Left audio peak" />
                        <TextBlock Grid.Row="1" Text="R" Style="{StaticResource StatusTextStyle}" />
                        <controls:LevelMeter Grid.Row="1" Grid.Column="1" Level="{x:Bind VM.AudioPeakRight, Mode=OneWay}"
                                             Hold="{x:Bind VM.AudioHoldRight, Mode=OneWay}"
                                             AutomationProperties.Name="Right audio peak" />
                    </Grid>

                    <!-- Mute: icon-only; the speaker glyph shows the state. The checked state is deliberately
                         not accent-filled ("filled = muted" vs "filled = sound on" is ambiguous). Screen
                         readers get the toggle state plus the action name. -->
                    <ToggleButton Grid.Column="7" Grid.RowSpan="2" IsChecked="{x:Bind VM.IsMuted, Mode=TwoWay}"
                                  Width="36" Height="30" Padding="0" Margin="-8,0,0,0"
                                  Style="{StaticResource DefaultToggleButtonStyle}"
                                  AutomationProperties.Name="{x:Bind VM.MuteActionName, Mode=OneWay}"
                                  AutomationProperties.HelpText="Audio monitoring of the source"
                                  ToolTipService.ToolTip="{x:Bind VM.MuteActionName, Mode=OneWay}">
                        <ToggleButton.Resources>
                            <ResourceDictionary>
                                <ResourceDictionary.ThemeDictionaries>
                                    <ResourceDictionary x:Key="Default">
                                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                    </ResourceDictionary>
                                    <ResourceDictionary x:Key="Light">
                                        <StaticResource x:Key="ToggleButtonBackground" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundCheckedPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundPointerOver" ResourceKey="SubtleFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBackgroundPressed" ResourceKey="SubtleFillColorTertiaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundChecked" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPointerOver" ResourceKey="TextFillColorPrimaryBrush" />
                                        <StaticResource x:Key="ToggleButtonForegroundCheckedPressed" ResourceKey="TextFillColorSecondaryBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrush" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushChecked" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                                        <StaticResource x:Key="ToggleButtonBorderBrushCheckedPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                                    </ResourceDictionary>
                                    <!-- HighContrast: keep the system's toggle visuals. -->
                                    <ResourceDictionary x:Key="HighContrast" />
                                </ResourceDictionary.ThemeDictionaries>
                            </ResourceDictionary>
                        </ToggleButton.Resources>
                        <FontIcon Glyph="{x:Bind VM.MuteGlyph, Mode=OneWay}" FontSize="15" />
                    </ToggleButton>
            </Grid>
        </Border>

        <!-- ============================================================ finalizing overlay (close while capturing) -->
        <Grid x:Name="FinalizingOverlay" Grid.RowSpan="3" Visibility="Collapsed"
              Background="{ThemeResource SmokeFillColorDefaultBrush}">
            <Border Style="{StaticResource CardStyle}" Background="{ThemeResource SolidBackgroundFillColorBaseBrush}"
                    HorizontalAlignment="Center" VerticalAlignment="Center" Padding="32,24">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <ProgressRing IsActive="True" Width="40" Height="40" />
                    <TextBlock Text="Finalizing files…" Style="{StaticResource SubtitleTextBlockStyle}" HorizontalAlignment="Center"
                               AutomationProperties.LiveSetting="Assertive" />
                    <TextBlock Text="The window closes when the capture is safely written." Style="{StaticResource CaptionTextBlockStyle}"
                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
