<UserControl
    x:Class="PinnacleCapture.Views.KindSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:PinnacleCapture.ViewModels">

    <!-- One "Settings for: DV | HDV" page: format (its settings behind the gear), aspect, scene split,
         the two stops, the retry of bad sections (its settings behind the gear). -->
    <StackPanel Spacing="10">
        <Grid ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <Grid ColumnSpacing="4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ComboBox
                    Header="Format"
                    HorizontalAlignment="Stretch"
                    ItemsSource="{x:Bind ViewModel.Formats}"
                    SelectedItem="{x:Bind ViewModel.SelectedFormat, Mode=TwoWay}"
                    IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                    ToolTipService.ToolTip="{x:Bind ViewModel.FormatHelp}"
                    AutomationProperties.Name="{x:Bind FormatAutomationName}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:FormatItem">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Label}" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Extension}"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                           VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <!-- the selected format's settings (deinterlace, quality, FFV1 compression), if it has any -->
                <Button Grid.Column="1" VerticalAlignment="Bottom" Width="36" Height="32" Padding="0"
                        IsEnabled="{x:Bind Both(ViewModel.FormatOptions.HasAny, IsEditable), Mode=OneWay}"
                        AutomationProperties.Name="{x:Bind FormatSettingsAutomationName}"
                        AutomationProperties.HelpText="Deinterlacing, quality or compression of the selected format, where it has any"
                        ToolTipService.ToolTip="Format settings">
                    <FontIcon Glyph="&#xE713;" FontSize="14" />
                    <Button.Flyout>
                        <Flyout x:Name="FormatFlyout" Placement="BottomEdgeAlignedRight" />
                    </Button.Flyout>
                </Button>
            </Grid>
            <!-- Disabled for a format that stores no aspect (raw .dv / .m2t; the choice is kept but Auto
                 applies). A disabled control shows no tooltip, so the Grid around it carries the core's text. -->
            <Grid Grid.Column="1" Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.AspectHelp, Mode=OneWay}">
                <ComboBox Header="Aspect" HorizontalAlignment="Stretch"
                          SelectedIndex="{x:Bind ViewModel.AspectIndex, Mode=TwoWay}"
                          IsEnabled="{x:Bind Both(ViewModel.AspectEnabled, IsEditable), Mode=OneWay}"
                          AutomationProperties.Name="{x:Bind AspectAutomationName}"
                          AutomationProperties.HelpText="{x:Bind ViewModel.AspectHelp, Mode=OneWay}">
                    <ComboBoxItem Content="Auto" />
                    <ComboBoxItem Content="4:3" />
                    <ComboBoxItem Content="16:9" />
                </ComboBox>
            </Grid>
        </Grid>

        <!-- the core's warning for the selected format (H.264 / HEVC: lossy) -->
        <InfoBar Severity="Warning" IsClosable="False"
                 IsOpen="{x:Bind ViewModel.FormatOptions.HasWarning, Mode=OneWay}"
                 Message="{x:Bind ViewModel.FormatOptions.Warning, Mode=OneWay}" />

        <!-- the Grid carries the tooltip: a disabled CheckBox shows none (HDV MOV / MKV always split) -->
        <Grid Background="Transparent" HorizontalAlignment="Left"
              ToolTipService.ToolTip="{x:Bind ViewModel.SplitHelp, Mode=OneWay}">
            <CheckBox
                Content="Split into scenes"
                IsChecked="{x:Bind ViewModel.SplitChecked, Mode=TwoWay}"
                IsEnabled="{x:Bind Both(ViewModel.SplitEnabled, IsEditable), Mode=OneWay}"
                AutomationProperties.HelpText="{x:Bind ViewModel.SplitHelp, Mode=OneWay}" />
        </Grid>

        <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <NumberBox
                Header="Stop no signal (min)"
                Minimum="0" Maximum="600" SmallChange="1" LargeChange="5"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.IdleStopMinutes, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                AutomationProperties.Name="Stop when no signal for this many minutes"
                AutomationProperties.HelpText="Ends the capture after this many minutes without signal or data (the end of the tape). The time a retry spends winding back does not count. 0 disables it (never stops automatically)."
                ToolTipService.ToolTip="Ends the capture after this many minutes without signal or data (the end of the tape). The time a retry spends winding back does not count. 0 disables it (never stops automatically)." />
            <NumberBox
                Grid.Column="1"
                Header="Stop after (min)"
                Minimum="0" Maximum="600" SmallChange="1" LargeChange="5"
                SpinButtonPlacementMode="Compact"
                Value="{x:Bind ViewModel.MaxDurationMinutes, Mode=TwoWay}"
                IsEnabled="{x:Bind IsEditable, Mode=OneWay}"
                AutomationProperties.Name="Stop this many minutes into the capture, regardless of signal"
                AutomationProperties.HelpText="Ends the capture and stops the tape after this many minutes of capture, whether or not signal is present. The time a retry spends winding back and re-reading does not count. 0 disables it."
                ToolTipService.ToolTip="Ends the capture and stops the tape after this many minutes of capture, whether or not signal is present. The time a retry spends winding back and re-reading does not count. 0 disables it." />
        </Grid>

        <!-- Retry bad sections, its settings behind the gear (shared by DV and HDV). The Grid carries
             the tooltip: a disabled CheckBox shows none. -->
        <StackPanel Orientation="Horizontal" Spacing="4">
            <Grid Background="Transparent" ToolTipService.ToolTip="{x:Bind ViewModel.RetryHelp}">
                <CheckBox
                    Content="Retry bad sections"
                    IsChecked="{x:Bind ViewModel.Retry, Mode=TwoWay}"
                    IsEnabled="{x:Bind Both(ViewModel.RetryEnabled, IsEditable), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind RetryAutomationName}"
                    AutomationProperties.HelpText="{x:Bind ViewModel.RetryHelp}" />
            </Grid>
            <Button VerticalAlignment="Center" Width="36" Height="32" Padding="0"
                    IsEnabled="{x:Bind Both(ViewModel.RetryEnabled, IsEditable), Mode=OneWay}"
                    AutomationProperties.Name="{x:Bind RetrySettingsAutomationName}"
                    AutomationProperties.HelpText="Attempts, memory window, preroll and what damage asks for a re-read"
                    ToolTipService.ToolTip="Retry settings">
                <FontIcon Glyph="&#xE713;" FontSize="14" />
                <Button.Flyout>
                    <Flyout x:Name="RetryFlyout" Placement="BottomEdgeAlignedLeft" />
                </Button.Flyout>
            </Button>
        </StackPanel>
    </StackPanel>
</UserControl>
